# 高德 JS API Web 端 Key，前端加载地图时使用
NEXT_PUBLIC_AMAP_JS_KEY=

# 高德 JS API 安全密钥，只能服务端读取
AMAP_JS_SECURITY_CODE=

# 高德 Web 服务 Key，只能服务端读取，用于逆地理编码
AMAP_WEB_SERVICE_KEY=

# 高德 JS API 安全代理前缀
NEXT_PUBLIC_AMAP_SERVICE_HOST=/_AMapService

# PostgreSQL 数据库连接
DATABASE_URL=postgresql://root:lch20201710.@localhost:5432/eleswhere

# 集成测试数据库连接，必须使用独立测试库，库名必须以 _test 结尾
TEST_DATABASE_URL=postgresql://root:lch20201710.@localhost:5432/eleswhere_test
RUN_DB_INTEGRATION_TESTS=false

# 本地图片上传目录
UPLOAD_DIR=D:/Eleswhere/.uploads
NEXT_PUBLIC_UPLOAD_BASE_URL=/uploads
